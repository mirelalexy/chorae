{
  "name": "chorae-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "match": "tsx --env-file=.env src/scripts/match.ts",
    "match:fixtures": "tsx --env-file=.env src/scripts/match-fixtures.ts",
    "rae:questions": "tsx --env-file=.env src/scripts/rae-questions.ts",
    "rae:draft": "tsx --env-file=.env src/scripts/rae-draft.ts",
    "dev-user": "tsx --env-file=.env src/scripts/dev-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
